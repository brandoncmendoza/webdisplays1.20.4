package net.montoyo.wd.net;

import net.minecraft.resources.ResourceLocation;
import net.minecraftforge.network.ChannelBuilder;
import net.minecraftforge.network.SimpleChannel;
import net.minecraftforge.network.NetworkDirection;
import net.minecraftforge.fml.loading.FMLEnvironment;
import net.minecraftforge.api.distmarker.Dist;
import net.minecraftforge.event.network.CustomPayloadEvent;
import net.montoyo.wd.net.client_bound.*;
import net.montoyo.wd.net.server_bound.*;

public class WDNetworkRegistry {
    private static final int PROTOCOL_VERSION = 1;
    
    public static final SimpleChannel INSTANCE = ChannelBuilder
            .named(new ResourceLocation("webdisplays", "main"))
            .serverAcceptedVersions((status, version) -> true)
            .clientAcceptedVersions((status, version) -> true)
            .networkProtocolVersion(PROTOCOL_VERSION)
            .simpleChannel();

    public static void init() {
        int id = 0;
        
        INSTANCE.messageBuilder(C2SMessageScreenCtrl.class, id++, NetworkDirection.PLAY_TO_SERVER)
                .encoder(C2SMessageScreenCtrl::write).decoder(C2SMessageScreenCtrl::new).consumerMainThread(C2SMessageScreenCtrl::handle).add();
        
        INSTANCE.messageBuilder(C2SMessageACQuery.class, id++, NetworkDirection.PLAY_TO_SERVER)
                .encoder(C2SMessageACQuery::write).decoder(C2SMessageACQuery::new).consumerMainThread(C2SMessageACQuery::handle).add();
        
        INSTANCE.messageBuilder(C2SMessageMinepadUrl.class, id++, NetworkDirection.PLAY_TO_SERVER)
                .encoder(C2SMessageMinepadUrl::write).decoder(C2SMessageMinepadUrl::new).consumerMainThread(C2SMessageMinepadUrl::handle).add();
        
        INSTANCE.messageBuilder(C2SMessageMiniservConnect.class, id++, NetworkDirection.PLAY_TO_SERVER)
                .encoder(C2SMessageMiniservConnect::write).decoder(C2SMessageMiniservConnect::new).consumerMainThread(C2SMessageMiniservConnect::handle).add();
        
        INSTANCE.messageBuilder(C2SMessageRedstoneCtrl.class, id++, NetworkDirection.PLAY_TO_SERVER)
                .encoder(C2SMessageRedstoneCtrl::write).decoder(C2SMessageRedstoneCtrl::new).consumerMainThread(C2SMessageRedstoneCtrl::handle).add();

        registerClientMessage(INSTANCE, S2CMessageServerInfo.class, id++, S2CMessageServerInfo::write, S2CMessageServerInfo::new, S2CMessageServerInfo::handle);
        registerClientMessage(INSTANCE, S2CMessageACResult.class, id++, S2CMessageACResult::write, S2CMessageACResult::new, S2CMessageACResult::handle);
        registerClientMessage(INSTANCE, S2CMessageAddScreen.class, id++, S2CMessageAddScreen::write, S2CMessageAddScreen::new, S2CMessageAddScreen::handle);
        registerClientMessage(INSTANCE, S2CMessageCloseGui.class, id++, S2CMessageCloseGui::write, S2CMessageCloseGui::new, S2CMessageCloseGui::handle);
        registerClientMessage(INSTANCE, S2CMessageJSResponse.class, id++, S2CMessageJSResponse::write, S2CMessageJSResponse::new, S2CMessageJSResponse::handle);
        registerClientMessage(INSTANCE, S2CMessageOpenGui.class, id++, S2CMessageOpenGui::write, S2CMessageOpenGui::new, S2CMessageOpenGui::handle);
        registerClientMessage(INSTANCE, S2CMessageScreenUpdate.class, id++, S2CMessageScreenUpdate::write, S2CMessageScreenUpdate::new, S2CMessageScreenUpdate::handle);
    }

    private static <MSG> void registerClientMessage(SimpleChannel channel, Class<MSG> clazz, int id, 
                                                   java.util.function.BiConsumer<MSG, net.minecraft.network.FriendlyByteBuf> encoder,
                                                   java.util.function.Function<net.minecraft.network.FriendlyByteBuf, MSG> decoder,
                                                   java.util.function.BiConsumer<MSG, CustomPayloadEvent.Context> handler) {
        channel.messageBuilder(clazz, id, NetworkDirection.PLAY_TO_CLIENT)
                .encoder(encoder)
                .decoder(decoder)
                .consumerMainThread((msg, ctx) -> {
                    if (FMLEnvironment.dist == Dist.CLIENT) {
                        handler.accept(msg, ctx);
                    }
                }).add();
    }
}
